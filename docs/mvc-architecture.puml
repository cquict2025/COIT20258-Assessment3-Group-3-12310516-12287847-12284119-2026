@startuml
title DRS-Enhanced - MVC on the client, business logic on the server (COIT20258 Assessment 3)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 14
skinparam ranksep 34
skinparam package {
  BackgroundColor #f5f6f8
  BorderColor #52606d
}
skinparam class {
  BackgroundColor White
  BorderColor #1f2933
}

package "CLIENT TIER - JavaFX (au.edu.cqu.drs.client, controller, view)" as CT {

  package "View - FXML" as V {
    class "login.fxml\nmain.fxml\ndashboard.fxml\nreport-form.fxml" as v1
    class "assessment.fxml\ncoordination.fxml\nfield-update.fxml" as v2
    class "warning-main.fxml\nwarning-board.fxml\nwarning-ack.fxml\n(Feature 1, Milan)" as v3
    v1 -[hidden]right- v2
    v2 -[hidden]right- v3
  }

  package "Controller - event handling only" as C {
    class LoginController
    class MainController
    class DashboardController <<Feature 2>>
    class "Report / Assessment /\nCoordination / FieldUpdate\nControllers" as others
    class "controller.warning.*\n(Feature 1)" as wc
    LoginController -[hidden]right- MainController
    MainController -[hidden]right- DashboardController
    DashboardController -[hidden]right- others
    others -[hidden]right- wc
  }

  package "Client model - proxy for the server" as CM {
    class RemoteServices <<Proxy>> {
      + submitReport(report) : ServiceResult<DisasterReport>
      + findOpenIncidents() : ServiceResult<List<Incident>>
      + findAlerts() : ServiceResult<List<EscalationAlert>>
    }
    class ClientSession {
      - sessionToken : String
      - currentUser : User
      + login(username, password) : ServiceResult<User>
      + send(request) : Response
    }
    class ServerConnection {
      + send(request) : Response
    }
    class BackgroundCall {
      + run(screen, call, onDone) : void
    }
    class "event.EventListener" as EL <<Feature 2>> {
      + addListener(listener) : void
      + getRecentEvents() : List<ServerEvent>
    }
  }
}

package "PROTOCOL (au.edu.cqu.drs.protocol) - shared by both tiers" as P {
  class Request <<Command>> {
    - requestId : String
    - command : Command
    - sessionToken : String
    - payload : Map<String, Serializable>
  }
  class Response {
    - success : boolean
    - value : Serializable
    - errorCode : ErrorCode
    + fromServiceResult(id, result) : Response
  }
  class ProtocolFilter <<ObjectInputFilter>>
  class MessageStreams
}

package "SERVER TIER - multi-threaded (au.edu.cqu.drs.server)" as ST {
  class DrsServer {
    - workers : ExecutorService
    + start() : void
  }
  class ClientHandler <<Runnable>>
  class RequestDispatcher {
    - handlers : EnumMap<Command, CommandHandler>
    - lock : ReadWriteLock
    + dispatch(request) : Response
  }
  class SessionManager {
    - sessions : ConcurrentHashMap
  }
  class AccessMatrixPolicy <<AuthorisationPolicy>>
  class CoreCommands
  class ModuleRegistry {
    + load(resource, context) : ModuleRegistry
  }
  class "WarningModule / ImportModule\n(CommandModule, Milan)" as mods
  class "event.EventBus\nevent.EventChannel\nevent.EscalationMonitor" as ev <<Feature 2>>
  class ServerContext
}

package "Business logic - application services (all business rules)" as S {
  class "AuthenticationService\nReportService\nIncidentService\nAssessmentService" as s1
  class "CoordinationService\nEscalationService\nDuplicateDetectionService\nAuditService" as s2
  class "WarningService\n(Feature 1, Milan)" as s3
  s1 -[hidden]right- s2
  s2 -[hidden]right- s3
}

package "DATA TIER - repository interfaces and adapters (Strategy)" as R {
  interface "UserRepository, ReportRepository,\nIncidentRepository, ... WarningRepository" as repos
  class "MySql*Repository\n(default, Milan)" as mysql
  class "Sqlite*Repository" as sqlite
  class "InMemory*Repository" as memory
  class "MySQL database drs" as db <<database>>
  repos <|.. mysql
  repos <|.. sqlite
  repos <|.. memory
  mysql --> db
}

v1 ..> LoginController : user events
v1 ..> DashboardController
LoginController --> ClientSession
DashboardController --> RemoteServices
DashboardController --> EL : live events
others --> RemoteServices
RemoteServices --> ClientSession
ClientSession --> ServerConnection
ServerConnection ..> Request : sends
ServerConnection ..> Response : receives
EL ..> MessageStreams : second socket

DrsServer --> ClientHandler : one per client,\non a worker thread
ClientHandler --> RequestDispatcher
ClientHandler ..> ProtocolFilter
RequestDispatcher --> SessionManager : token -> user
RequestDispatcher --> AccessMatrixPolicy : role allowed?
RequestDispatcher --> CoreCommands
RequestDispatcher --> ModuleRegistry
ModuleRegistry --> mods
RequestDispatcher --> ev : publish change
CoreCommands --> ServerContext
ServerContext --> s1
ServerContext --> s2
mods --> s3
s1 --> repos
s2 --> repos
s3 --> repos

note bottom of CT
  Controllers hold no business rules and no SQL. Every server call runs
  through BackgroundCall on a worker thread, so the JavaFX thread never blocks.
end note

note bottom of R
  The services depend only on repository interfaces, so the same rules run
  on MySQL, SQLite or in memory, chosen by repository= in drs-server.properties.
end note

@enduml
