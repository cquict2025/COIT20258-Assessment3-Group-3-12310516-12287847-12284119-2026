<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="12" styleClass="content-area"
      stylesheets="@warning.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="au.edu.cqu.drs.controller.warning.WarningBoardController">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label styleClass="screen-title" text="Current warnings" />
            <Label styleClass="hint-label"
                   text="Warnings in force now, most urgent first. No sign-in needed." />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
    </HBox>
    <Label fx:id="updatedLabel" styleClass="hint-label" />
    <Label fx:id="messageLabel" styleClass="error-label" />
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="cardBox" spacing="10" />
    </ScrollPane>
</VBox>
