<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10" styleClass="content-area"
      stylesheets="@warning.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="au.edu.cqu.drs.controller.warning.WarningAckController">
    <Label styleClass="screen-title" text="Warnings for your department" />
    <Label fx:id="departmentLabel" styleClass="hint-label" />

    <TableView fx:id="warningTable" prefHeight="260" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="codeColumn" text="Warning" prefWidth="90" />
            <TableColumn fx:id="levelColumn" text="Level" prefWidth="150" />
            <TableColumn fx:id="areaColumn" text="Affected area" prefWidth="220" />
            <TableColumn fx:id="expiresColumn" text="Expires" prefWidth="160" />
            <TableColumn fx:id="ackColumn" text="Your department" prefWidth="170" />
        </columns>
    </TableView>

    <Label fx:id="detailLabel" styleClass="card-detail" wrapText="true"
           minHeight="40" text="Select a warning to read it in full." />

    <HBox spacing="10">
        <Button fx:id="acknowledgeButton"
                onAction="#handleAcknowledge" text="Acknowledge selected" />
        <Button onAction="#handleRefresh" text="Refresh" />
    </HBox>
    <Label fx:id="messageLabel" styleClass="error-label" />
</VBox>
