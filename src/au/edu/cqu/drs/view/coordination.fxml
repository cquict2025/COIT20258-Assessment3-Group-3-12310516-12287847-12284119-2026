<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="screen-title" text="Coordinate departments" />
    <Label styleClass="hint-label"
           text="Each department request is tracked separately with its own status, reason and ETA. A failed transmission stays visible and can be retried; it is never shown as a rejection." />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Incident" />
        <ComboBox fx:id="incidentCombo" prefWidth="380" />
        <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
        <CheckBox fx:id="simulateOutageCheck" onAction="#handleToggleOutage"
                  text="Simulate partner outage" />
    </HBox>

    <Label fx:id="recommendationLabel" styleClass="hint-label" />

    <TitledPane expanded="true" text="Create a departmental request">
        <GridPane hgap="10" vgap="8">
            <columnConstraints>
                <ColumnConstraints minWidth="110" />
                <ColumnConstraints minWidth="230" />
                <ColumnConstraints minWidth="110" />
                <ColumnConstraints minWidth="230" />
            </columnConstraints>
            <Label text="Department" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <ComboBox fx:id="departmentCombo" prefWidth="220"
                      GridPane.rowIndex="0" GridPane.columnIndex="1" />
            <Label text="Urgency" GridPane.rowIndex="0" GridPane.columnIndex="2" />
            <ComboBox fx:id="urgencyCombo" prefWidth="220"
                      GridPane.rowIndex="0" GridPane.columnIndex="3" />
            <Label text="Requested action" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="actionField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       GridPane.columnSpan="3" />
            <Button fx:id="createButton" onAction="#handleCreateAssignment"
                    text="Send request" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        </GridPane>
    </TitledPane>

    <TableView fx:id="assignmentTable" prefHeight="180">
        <columns>
            <TableColumn fx:id="assignmentIdColumn" prefWidth="90" text="Request" />
            <TableColumn fx:id="departmentColumn" prefWidth="150" text="Department" />
            <TableColumn fx:id="actionColumn" prefWidth="200" text="Requested action" />
            <TableColumn fx:id="urgencyColumn" prefWidth="90" text="Urgency" />
            <TableColumn fx:id="assignmentStatusColumn" prefWidth="150" text="Status" />
            <TableColumn fx:id="etaColumn" prefWidth="120" text="ETA" />
            <TableColumn fx:id="attemptsColumn" prefWidth="80" text="Attempts" />
        </columns>
    </TableView>

    <TitledPane expanded="true" text="Respond, retry or allocate resources">
        <VBox spacing="8">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Response" />
                <ComboBox fx:id="responseCombo" prefWidth="200" />
                <Label text="Reason" />
                <TextField fx:id="reasonField" prefWidth="200" />
                <Label text="ETA (HH:mm)" />
                <TextField fx:id="etaField" prefWidth="80" promptText="16:45" />
                <Button fx:id="respondButton" onAction="#handleRespond" text="Record response" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="retryButton" onAction="#handleRetry" text="Retry delivery" />
                <Label text="Resource" />
                <TextField fx:id="resourceField" prefWidth="160" promptText="Pumper 12" />
                <Label text="Quantity" />
                <TextField fx:id="quantityField" prefWidth="60" text="1" />
                <Label text="From (HH:mm)" />
                <TextField fx:id="fromField" prefWidth="80" promptText="15:00" />
                <Label text="To (HH:mm)" />
                <TextField fx:id="toField" prefWidth="80" promptText="19:00" />
                <Button fx:id="allocateButton" onAction="#handleAllocate" text="Allocate" />
            </HBox>
        </VBox>
    </TitledPane>

    <Label fx:id="messageLabel" styleClass="error-label" />
</VBox>
