<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label styleClass="screen-title" text="Disaster Response System" />
    <Label styleClass="hint-label"
           text="Sign in to coordinate incidents. Members of the public can report a disaster without an account." />

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="90" />
            <ColumnConstraints minWidth="260" />
        </columnConstraints>
        <Label text="Username" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="usernameField" promptText="coordinator"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <Label text="Password" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10">
        <Button fx:id="signInButton" defaultButton="true" onAction="#handleSignIn" text="Sign in" />
        <Button fx:id="publicReportButton" onAction="#handlePublicReport"
                text="Report a disaster without signing in" />
        <Button fx:id="publicWarningsButton" onAction="#handlePublicWarnings"
                text="Public warnings" />
    </HBox>

    <Label fx:id="messageLabel" styleClass="error-label" />

    <Label styleClass="hint-label"
           text="Demonstration accounts: coordinator / liaison / responder / admin. Password for all: Password1" />
</VBox>
